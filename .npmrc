# Node.js version requirement for this project.
# Developers and CI must use Node 20 LTS (Iron).
# Recommended: use nvm or fnm to manage versions.
#   nvm: nvm use
#   fnm: fnm use

# engine-strict=true — enable when all devs are on Node 20

# NestJS requires singleton instances shared across the whole module graph.
# Without hoisting, pnpm isolates @nestjs/* packages per-service, which breaks
# the DI container and decorator metadata (reflect-metadata must be a singleton too).
public-hoist-pattern[]=@nestjs/*
public-hoist-pattern[]=reflect-metadata
