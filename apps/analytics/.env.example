# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: Postgres is exposed on port 5433 by Docker
# Production: use PgBouncer URL (port 5432 inside Docker network)
DATABASE_URL="postgresql://flowmesh:change_me@localhost:5433/flowmesh?schema=analytics"

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://flowmesh:change_me@localhost:5672/flowmesh"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 1 — ephemeral (metrics cache, live dashboard pub/sub)
REDIS_EPHEMERAL_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by the auth service to sign JWTs
# Generate with: openssl rand -hex 64
JWT_SECRET="change_me"

# ─── Service port ────────────────────────────────────────────────────────────
PORT=3006
NODE_ENV=development
