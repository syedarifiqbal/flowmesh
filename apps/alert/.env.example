# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: Postgres is exposed on port 5433 by Docker
# Production: use PgBouncer URL (port 5432 inside Docker network)
DATABASE_URL="postgresql://flowmesh:change_me@localhost:5433/flowmesh?schema=alert"

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://flowmesh:change_me@localhost:5672/flowmesh"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 1 — ephemeral (count_threshold counters)
REDIS_EPHEMERAL_URL="redis://localhost:6379"

# ─── SMTP (email channel) ────────────────────────────────────────────────────
# Required only when using the email notification channel.
# For local dev with Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025, leave user/pass empty.
# For Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=re_your_key
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@flowmesh.io"

# ─── Service port ────────────────────────────────────────────────────────────
PORT=3007
NODE_ENV=development
