generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  eventId       String   @unique @map("event_id")
  correlationId String   @map("correlation_id")
  eventName     String   @map("event_name")
  source        String
  version       String
  userId        String?  @map("user_id")
  anonymousId   String?  @map("anonymous_id")
  sessionId     String?  @map("session_id")
  properties    Json     @default("{}")
  context       Json     @default("{}")
  receivedAt    DateTime @default(now()) @map("received_at")
  ingestedAt    DateTime @default(now()) @map("ingested_at")

  @@index([workspaceId, receivedAt(sort: Desc)])
  @@index([correlationId])
  @@index([workspaceId, eventName])
  @@map("events")
}

model UserTrait {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  anonymousId String?  @map("anonymous_id")
  traits      Json     @default("{}")
  source      String
  version     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([workspaceId, userId])
  @@map("user_traits")
}

model AliasMap {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  anonymousId String   @map("anonymous_id")
  userId      String   @map("user_id")
  source      String
  version     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, anonymousId])
  @@index([workspaceId, userId])
  @@map("alias_map")
}

model GroupTrait {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  groupId     String   @map("group_id")
  userId      String   @map("user_id")
  traits      Json     @default("{}")
  source      String
  version     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, groupId, userId])
  @@index([workspaceId, groupId])
  @@index([workspaceId, userId])
  @@map("group_traits")
}
