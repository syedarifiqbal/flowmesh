# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: Postgres is exposed on port 5433 by Docker
# Production: use PgBouncer URL (port 5432 inside Docker network)
DATABASE_URL="postgresql://flowmesh:change_me@localhost:5433/flowmesh?schema=auth"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 2 — persistent AOF (revoked JWT blacklist)
REDIS_PERSISTENT_URL="redis://localhost:6380"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate both secrets with: openssl rand -hex 64
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Service port ────────────────────────────────────────────────────────────
PORT=3004
NODE_ENV=development
