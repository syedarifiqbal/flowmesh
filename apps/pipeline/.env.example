# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: Postgres is exposed on port 5433 by Docker
# Production: use PgBouncer URL (port 5432 inside Docker network)
DATABASE_URL="postgresql://flowmesh:change_me@localhost:5433/flowmesh?schema=pipeline"

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://flowmesh:change_me@localhost:5672/flowmesh"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 1 — ephemeral (pipeline config cache, 5-minute TTL)
REDIS_EPHEMERAL_URL="redis://localhost:6379"
# Redis 2 — persistent AOF (idempotency keys)
REDIS_PERSISTENT_URL="redis://localhost:6380"

# ─── Config service ──────────────────────────────────────────────────────────
# Local dev: config-service runs on port 3002
CONFIG_SERVICE_URL="http://localhost:3002"

# ─── Service port ────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development
