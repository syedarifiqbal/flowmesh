# ─── Upstream services ───────────────────────────────────────────────────────
# Local dev: each service runs on its own port
INGESTION_SERVICE_URL="http://127.0.0.1:3001"
CONFIG_SERVICE_URL="http://127.0.0.1:3002"
AUTH_SERVICE_URL="http://127.0.0.1:3004"
PIPELINE_SERVICE_URL="http://127.0.0.1:3003"
DELIVERY_SERVICE_URL="http://127.0.0.1:3005"
ANALYTICS_SERVICE_URL="http://127.0.0.1:3006"
ALERT_SERVICE_URL="http://127.0.0.1:3007"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 1 — ephemeral (sliding-window rate limit counters per API key)
REDIS_EPHEMERAL_URL="redis://127.0.0.1:6379"
# Redis 2 — persistent AOF (token blacklist for revoked JWTs and API keys)
REDIS_PERSISTENT_URL="redis://127.0.0.1:6380"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by the auth service to sign JWTs
# Generate with: openssl rand -hex 64
JWT_SECRET="change_me"

# ─── Service port ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
