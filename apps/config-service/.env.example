# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: Postgres is exposed on port 5433 by Docker
# Production: use PgBouncer URL (port 5432 inside Docker network)
DATABASE_URL="postgresql://flowmesh:change_me@localhost:5433/flowmesh?schema=config"

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://flowmesh:change_me@localhost:5672/flowmesh"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 1 — ephemeral (pipeline config cache, 5-minute TTL)
REDIS_EPHEMERAL_URL="redis://localhost:6379"
# Redis 2 — persistent AOF (idempotency keys, token blacklist)
REDIS_PERSISTENT_URL="redis://localhost:6380"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by the auth service to sign JWTs
# Generate with: openssl rand -hex 64
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Encryption ──────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting destination credentials at rest.
# Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY="change_me"

# ─── Service port ────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
